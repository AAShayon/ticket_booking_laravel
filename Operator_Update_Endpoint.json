{
	"info": {
		"_postman_id": "operator-update-endpoint",
		"name": "Operator Update Endpoint",
		"description": "Postman collection for updating operators with image upload capability",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Update Operator with Image",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer <your-api-token>"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "_method",
							"value": "PUT",
							"type": "text"
						},
						{
							"key": "name",
							"value": "Updated Operator Name",
							"type": "text"
						},
						{
							"key": "contact_email",
							"value": "contact@example.com",
							"type": "text"
						},
						{
							"key": "contact_phone",
							"value": "+1234567890",
							"type": "text"
						},
						{
							"key": "admin_commission_percentage",
							"value": "15.5",
							"type": "text"
						},
						{
							"key": "nid",
							"value": "123456789",
							"type": "text"
						},
						{
							"key": "address",
							"value": "123 Updated Street, City",
							"type": "text"
						},
						{
							"key": "transport_business_license",
							"value": "TBL-98765",
							"type": "text"
						},
						{
							"key": "logo",
							"type": "file",
							"src": "/path/to/your/image.jpg"
						}
					]
				},
				"url": {
					"raw": "https://your-domain.com/api/operators/1",
					"protocol": "https",
					"host": [
						"your-domain",
						"com"
					],
					"path": [
						"api",
						"operators",
						"1"
					]
				},
				"description": "Update an operator with all fields including image upload. Uses POST with _method=PUT for proper form-data handling."
			},
			"response": []
		}
	]
}